{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zjashanda/ark-archive/schemas/receipt.v1.json",
  "title": "Ark 归档回执 receipt.v1",
  "description": "由 bin/ark_receipt.py 从归档 manifest 生成的运行回执。所有用户可见时间均为北京时间 YYYY-MM-DD HH:MM:SS，不含 T / Z / 时区偏移（NOAH-43）。使用 --legacy-rfc3339 生成的旧格式回执有意不满足本 schema 的时间正则。",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "task",
    "skill",
    "skill_version",
    "scope",
    "result",
    "totals",
    "failures",
    "bugs_found",
    "evidence_dir",
    "evidence_sha256",
    "evidence_files",
    "lessons",
    "confidence",
    "started_at",
    "ended_at",
    "notes",
    "tags",
    "archive"
  ],
  "properties": {
    "schema": {
      "description": "回执 schema 标识，固定为 run.receipt.v1",
      "const": "run.receipt.v1"
    },
    "run_id": {
      "description": "运行标识，通常是 YYYYMMDD-HHMMSS_slug（历史归档可能为下划线 YYYYMMDD_HHMMSS 形式）",
      "type": "string",
      "minLength": 1
    },
    "task": {
      "description": "任务描述，进 KB 标题/claim",
      "type": "string"
    },
    "skill": {
      "description": "产出该结果的 skill 名",
      "type": "string"
    },
    "skill_version": {
      "description": "skill 版本",
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": ["device", "project", "firmware", "platform"],
      "additionalProperties": false,
      "properties": {
        "device": {
          "description": "设备型号（来自 manifest.device），可为 null",
          "type": ["string", "null"]
        },
        "project": {
          "type": "string"
        },
        "firmware": {
          "description": "固件标识，可为 null",
          "type": ["string", "null"]
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "result": {
      "description": "结果判定：pass/fail/blocked/invalid/needs_review",
      "type": "string",
      "enum": ["pass", "fail", "blocked", "invalid", "needs_review"]
    },
    "result_source": {
      "description": "结果来源证据：保留 manifest 原始 result 与归一依据（D9）",
      "type": "object",
      "required": ["raw_result", "normalized", "derived_from", "failed"],
      "additionalProperties": false,
      "properties": {
        "raw_result": {"type": "string"},
        "normalized": {"type": "boolean"},
        "derived_from": {"type": "string", "enum": ["result_map", "status_counts"]},
        "failed": {"type": "integer", "minimum": 0},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "rounds",
        "target_rounds",
        "duration_minutes",
        "recognized",
        "failed",
        "recognition_rate",
        "boundary_unexpected",
        "serial_error_kinds",
        "warning_markers",
        "archived_files",
        "archived_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "rounds": { "type": "integer", "minimum": 0 },
        "target_rounds": { "type": "integer", "minimum": 0 },
        "duration_minutes": { "type": "number", "minimum": 0 },
        "recognized": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "recognition_rate": {
          "description": "识别率；summary 未提供时为 null",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "boundary_unexpected": { "type": "integer", "minimum": 0 },
        "serial_error_kinds": { "type": "integer", "minimum": 0 },
        "warning_markers": { "type": "integer", "minimum": 0 },
        "archived_files": { "type": "integer", "minimum": 0 },
        "archived_bytes": { "type": "integer", "minimum": 0 },
        "status_counts": {
          "description": "summary 提供的状态计数；无则整个字段省略",
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason", "attribution", "evidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "attribution": {
            "description": "归因：device / corpus / tool 等",
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "bugs_found": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidence_dir": {
      "description": "证据在存储服务器上的目录（不是跑测机临时目录）",
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "description": "每个证据文件的 sha256，顺序与 manifest.files 一致",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "lessons": {
      "type": "array"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "started_at": {
      "description": "开始时间，北京时间 YYYY-MM-DD HH:MM:SS",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "ended_at": {
      "description": "结束时间，北京时间 YYYY-MM-DD HH:MM:SS",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "archive": {
      "type": "object",
      "required": [
        "node",
        "project",
        "storage_root",
        "archived_at",
        "source_dir",
        "manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "storage_root": { "type": "string", "minLength": 1 },
        "archived_at": {
          "description": "归档时间，北京时间 YYYY-MM-DD HH:MM:SS",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "source_dir": {
          "description": "原始结果目录（跑测机上的路径），可为 null",
          "type": ["string", "null"]
        },
        "manifest_sha256": {
          "description": "生成本回执所用 manifest.json 的 sha256",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "kb_context": {
      "description": "可选：开工前知识查询留痕，形状见 ark.kb-context.v1（见 docs/reflow-contract.md）",
      "type": "object"
    },
    "delivery": {
      "description": "可选：归档后的回流状态，形状见 ark.delivery.v1（见 docs/reflow-contract.md）",
      "type": "object"
    },
    "checkpoints": {
      "description": "可选：事件驱动回流检查点摘要，形状见 ark.checkpoint.v1（见 docs/reflow-contract.md）。完整事件以 append-only WAL 为准，本数组只做聚合。",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "trigger", "quality", "at"],
        "additionalProperties": false,
        "properties": {
          "checkpoint_id": {
            "description": "sha256(issue_id|run_id|stage|event_seq|evidence_digest)，64 位小写十六进制",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "trigger": {
            "description": "检查点触发器；FINAL_RECEIPT 只做聚合与关闭 outbox，不在枚举内",
            "type": "string",
            "enum": [
              "EXECUTION_CHECK",
              "STAGE_FINISHED",
              "BLOCKED",
              "FAIL",
              "NEEDS_REVIEW",
              "WATCHDOG_RUNNING_NO_EVIDENCE",
              "WATCHDOG_STATE_DRIFT",
              "WATCHDOG_TIMEOUT",
              "WATCHDOG_HEARTBEAT_LOST",
              "MANUAL_CANCEL",
              "RUNTIME_CRASH",
              "RECOVERY_REPLAY"
            ]
          },
          "quality": {
            "type": "string",
            "enum": ["formal", "candidate", "evidence_gap"]
          },
          "at": {
            "description": "检查点时间，北京时间 YYYY-MM-DD HH:MM:SS",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
          }
        }
      }
    }
  }
}
